    "map_tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print at 100% scale (Actual Size). Disable 'Fit to Page' in your print dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime al 100% (Tamaño real). Desactiva «Ajustar a la página» en tu impresora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте в масштабе 100% (Реальный размер). Отключите «Подогнать по странице»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima em 100% (Tamanho real). Desative «Ajustar à página» na impressora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima em 100% (Tamanho real). Desative «Ajustar à página» na impressora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima em 100% (Tamanho real). Desative «Ajustar à página» na impressora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimez à 100 % (Taille réelle). Désactivez « Ajuster à la page »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 100 % (Originalgröße) drucken. «An Seite anpassen» deaktivieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stampa al 100% (Dimensioni reali). Disattiva «Adatta alla pagina»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请以 100%（实际大小）打印，并在打印设置中关闭“适合页面”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倍率100%（実際のサイズ）で印刷し、「ページに合わせる」を無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 배율(실제 크기)로 인쇄하고 '페이지에 맞춤'을 해제하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Друкуйте у масштабі 100% (Реальний розмір). Вимкніть «Вписати у сторінку»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukuj w skali 100% (Rozmiar rzeczywisty). Wyłącz „Dopasuj do strony”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 ölçekle (Gerçek Boyut) yazdırın. 'Sayfaya Sığdır' seçeneğini kapatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبع بمقياس 100% (الحجم الفعلي) وعطّل خيار «ملاءمة للصفحة»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100% स्केल (वास्तविक आकार) पर प्रिंट करें और 'Fit to Page' बंद रखें।"
          }
        }
      }
    },
