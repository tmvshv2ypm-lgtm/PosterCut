    "lbl_pdf_lossless_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves every pixel cleanly for study sheets, text & sharp prints"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva cada píxel sin compresión para láminas, textos e impresiones nítidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет каждый пиксель без сжатия для чётких схем, текста и фото"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva cada pixel sem compressão para lâminas, textos e impressões nítidas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva cada pixel sem compressão para lâminas, textos e impressões nítidas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva cada pixel sem compressão para lâminas, textos e impressões nítidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve chaque pixel sans compression pour les schémas, textes et tirages nets"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhält jedes Pixel verlustfrei für Lernbögen, Texte und gestochen scharfe Drucke"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva ogni pixel senza compressione per schede, testi e stampe nitide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损保留每个像素，适合学习图版、细小文字与高清打印"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習シートや文字、鮮明な印刷のために全ピクセルを劣化なく保持します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습 자료, 작은 글자 및 선명한 인쇄를 위해 모든 픽셀을 무손실로 유지합니다"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає кожен піксель без стиснення для чітких схем, тексту та друку"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje każdy piksel bez kompresji dla plansz, tekstu i ostrych wydruków"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma sayfaları, yazılar ve net baskılar için her pikseli sıkıştırmadan korur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ كل بكسل بدقة كاملة دون ضغط للوحات الدراسية والنصوص والطباعة الواضحة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अध्ययन शीट, टेक्स्ट और स्पष्ट प्रिंट के लिए हर पिक्सेल को बिना संपीड़न सुरक्षित रखता है"
          }
        }
      }
    },
