    "ios_app_info_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) splits high-resolution study sheets and photos into lossless UHD printable pages or vector halftone wall posters — fast, offline, and 100% private on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) divide láminas de estudio y fotos en hojas imprimibles sin pérdida UHD o en pósteres vectoriales de semitonos, de forma rápida y 100 % privada en tu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) разделяет учебные схемы и фотографии на листы для печати UHD без потерь или векторные постеры с полутонами — быстро и полностью локально на вашем устройстве."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) divide lâminas de estudo e fotos em folhas imprimíveis UHD sem perdas ou pôsteres vetoriais de meio-tom — rápido e 100% privado no seu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) divide lâminas de estudo e fotos em folhas imprimíveis UHD sem perdas ou pôsteres vetoriais de meio-tom — rápido e 100% privado no seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) divide lâminas de estudo e fotos em folhas imprimíveis UHD sem perdas ou pôsteres vetoriais de meio-tom — rápido e 100% privado no seu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) découpe vos planches d'étude et photos en feuilles imprimables UHD sans perte ou en posters vectoriels en demi-teintes — rapide et 100 % privé sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) teilt hochauflösende Lernbögen und Fotos verlustfrei in UHD-Druckseiten oder Vektor-Rasterposter – schnell, offline und 100 % privat auf deinem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) divide schede di studio e foto in fogli stampabili UHD senza perdita o poster vettoriali a mezzitoni — veloce, offline e al 100% privato sul tuo dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika（PosterCut）可将高清学习图版与照片切分为无损 UHD 打印页或矢量网点墙面海报，快速离线、100% 本地隐私保护。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika（PosterCut）は、高解像度の学習シートや写真を無劣化UHDの印刷ページやベクターハーフトーンポスターに分割します。オフラインで高速かつ完全にプライベートに動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika(PosterCut)는 고해상도 학습 시트와 사진을 무손실 UHD 인쇄 페이지나 벡터 하프톤 벽 포스터로 분할합니다. 기기 내에서 빠르고 안전하게 작동합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) розділяє навчальні схеми та фото на аркуші для друку UHD без втрат або векторні постери — швидко, офлайн і на 100% приватно на вашому пристрої."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) dzieli plansze edukacyjne i zdjęcia na bezstratne arkusze UHD do druku lub wektorowe plakaty rastrowe — szybko, offline i w 100% prywatnie na urządzeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut), yüksek çözünürlüklü çalışma levhalarını ve fotoğrafları kayıpsız UHD baskı sayfalarına veya vektörel duvar posterlerine böler — hızlı, çevrimdışı ve %100 cihazınızda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Mosaika (PosterCut) بتقسيم اللوحات الدراسية والصور عالية الدقة إلى صفحات طباعة UHD بدون فقدان جودة أو ملصقات جدارية متجهة — بسرعة وخصوصية كاملة على جهازك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaika (PosterCut) उच्च-रिज़ॉल्यूशन अध्ययन शीट और फ़ोटो को बिना गुणवत्ता खोए UHD प्रिंट पृष्ठों या वेक्टर हाफ़टोन पोस्टर में विभाजित करता है — तेज़, ऑफ़लाइन और 100% निजी।"
          }
        }
      }
    },
