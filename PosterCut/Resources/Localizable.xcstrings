    "ios_theme_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtle Liquid Glass tints adapt automatically to both Light and Dark Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tonos Liquid Glass se adaptan automáticamente al Modo Claro y al Modo Oscuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттенки Liquid Glass автоматически адаптируются к светлой и тёмной теме."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tons Liquid Glass adaptam-se automaticamente aos modos Claro e Escuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tons Liquid Glass adaptam-se automaticamente aos modos Claro e Escuro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tons Liquid Glass adaptam-se automaticamente aos modos Claro e Escuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teintes Liquid Glass s'adaptent automatiquement aux modes Clair et Sombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liquid-Glass-Akzente passen sich automatisch an den Hell- und Dunkelmodus an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tonalità Liquid Glass si adattano automaticamente alla modalità Chiara e Scura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 强调色会自动适配浅色与深色模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassのアクセントはライトモードとダークモードに自動対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 색상은 라이트 모드와 다크 모드에 자동으로 맞춰집니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтінки Liquid Glass автоматично адаптуються до світлої та темної теми."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odcienie Liquid Glass automatycznie dostosowują się do trybu jasnego i ciemnego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass tonları Açık ve Koyu moda otomatik olarak uyum sağlar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتكيف ألوان Liquid Glass تلقائياً مع الوضع الفاتح والوضع الداكن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass रंग लाइट और डार्क दोनों मोड में अपने आप ढल जाते हैं।"
          }
        }
      }
    },
