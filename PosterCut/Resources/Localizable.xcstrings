    "welcome_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a photo from Photos, Files, or Clipboard to split it into lossless UHD printable sheets or vector halftone posters — 100% on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto de Fotos, Archivos o el portapapeles para dividirla en hojas imprimibles sin pérdida UHD o pósteres vectoriales, 100 % en tu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото из «Фото», «Файлов» или буфера обмена, чтобы разбить его на листы UHD без потерь или векторный постер — полностью на устройстве."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto de Fotos, Arquivos ou da área de transferência para dividi-la em folhas UHD sem perdas ou pôsteres vetoriais, 100% no dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto de Fotos, Arquivos ou da área de transferência para dividi-la em folhas UHD sem perdas ou pôsteres vetoriais, 100% no dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto de Fotos, Arquivos ou da área de transferência para dividi-la em folhas UHD sem perdas ou pôsteres vetoriais, 100% no dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo depuis Photos, Fichiers ou le presse-papiers pour la découper en feuilles UHD sans perte ou en posters vectoriels, 100 % sur l'appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Foto aus Fotos, Dateien oder der Zwischenablage, um es verlustfrei in UHD-Druckbögen oder Vektor-Poster zu teilen – 100 % auf dem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una foto da Foto, File o appunti per dividerla in fogli stampabili UHD senza perdita o poster vettoriali, al 100% sul dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“照片”、“文件”或剪贴板选择图片，将其切分为无损 UHD 打印页或矢量网点海报，100% 本地处理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、ファイル、またはクリップボードから画像を選び、無劣化UHDの印刷シートやベクターポスターに分割します（すべて端末内で処理）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 파일 또는 클립보드에서 이미지를 선택해 무손실 UHD 인쇄 용지나 벡터 하프톤 포스터로 분할하세요. 100% 기기 내에서 처리됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть фото з «Фото», «Файлів» або буфера обміну, щоб розділити його на аркуші UHD без втрат або векторний постер — повністю на пристрої."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcie ze Zdjęć, Plików lub schowka, aby podzielić je na bezstratne arkusze UHD lub wektorowy plakat — w 100% na urządzeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar, Dosyalar veya panodan bir görsel seçin; kayıpsız UHD baskı sayfalarına veya vektörel posterlere tamamen cihazınızda bölün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة من الصور أو الملفات أو الحافظة لتقسيمها إلى صفحات طباعة UHD بدون فقدان جودة أو ملصقات متجهة — بالكامل على جهازك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो, फ़ाइलें या क्लिपबोर्ड से छवि चुनें और उसे बिना गुणवत्ता खोए UHD प्रिंट शीट या वेक्टर पोस्टर में विभाजित करें — 100% डिवाइस पर।"
          }
        }
      }
    },
